NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
SUPABASE_PROJECT_ID=
NEXT_PUBLIC_SITE_URL=
# Salts the IP hash used for checkout rate limiting (BLUEPRINT §8.2). Any
# random string; rotating it just resets everyone's rate-limit history.
IP_HASH_SALT=
# Upstash Redis — backs rate limiting (order submission, admin login) and the
# checkout idempotency cache (src/lib/redis.ts, src/lib/rate-limit.ts). Leave
# all four unset for local dev: it falls back to in-memory limiting and logs
# a warning. Production MUST set these — see deployment notes for how to
# create the database and where to put these in Vercel.
#
# Two naming schemes for the same credentials — set whichever pair matches
# how you provisioned the database (src/lib/redis.ts checks both, preferring
# UPSTASH_ if both happen to be set):
# - UPSTASH_REDIS_REST_URL/TOKEN: creating a database directly on Upstash.
# - KV_REST_API_URL/TOKEN: Vercel's Upstash Marketplace integration
#   (Storage tab) injects these instead, under the old Vercel KV naming.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Telegram new-order notifications (src/lib/telegram.ts, sent from
# submitCheckout after the order is committed). Leave both unset for local
# dev — it skips silently. Production MUST set these, or every notification
# silently vanishes (logged as an error, but no order will ever notify).
# TELEGRAM_BOT_TOKEN: from @BotFather after creating a bot.
# TELEGRAM_CHAT_ID: the chat (personal DM, group, or channel) the bot should
# post to — get it by messaging the bot once, then hitting
# https://api.telegram.org/bot<TOKEN>/getUpdates and reading `chat.id`.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
