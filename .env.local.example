NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
SUPABASE_PROJECT_ID=
NEXT_PUBLIC_SITE_URL=
# Salts the IP hash used for checkout rate limiting (BLUEPRINT §8.2). Any
# random string; rotating it just resets everyone's rate-limit history.
IP_HASH_SALT=
# Upstash Redis — backs rate limiting (order submission, admin login) and the
# checkout idempotency cache (src/lib/redis.ts, src/lib/rate-limit.ts). Leave
# both unset for local dev: it falls back to in-memory limiting and logs a
# warning. Production MUST set these — see deployment notes for how to
# create the database and where to put these in Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
